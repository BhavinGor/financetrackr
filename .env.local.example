# Local AI Configuration (default path)
USE_OLLAMA=true
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2:latest
JSON_PROVIDER=ollama

# OCR provider toggle: legacy | docling | lighton_hf | ollama_lighton
OCR_PROVIDER=ollama_lighton

# OCR via Ollama (recommended for your setup)
OCR_OLLAMA_URL=http://localhost:11434/api/generate
OCR_OLLAMA_MODEL=maternion/LightOnOCR-2

# OCR via HuggingFace local pipeline (optional)
OCR_MODEL_ID=lightonai/LightOnOCR-2-1B

# Local SQLite database path
SQLITE_DB_PATH=backend/data/financetrackr.db

# Optional AWS Bedrock Configuration (used only when provider=bedrock)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# Optional Gemini API Key (used only when provider=gemini)
GEMINI_API_KEY=your-gemini-api-key

# Frontend API URL (backend proxy)
VITE_API_URL=http://localhost:5000

# Backend Configuration
FLASK_DEBUG=True
FLASK_PORT=5000
ALLOWED_ORIGINS=http://localhost:5173
